# Copy to .env and adjust if you want. .env is gitignored and must stay that way.
#
# NOTE: this project needs NO credentials. It is a dry-run grid simulator with
# no live order path — src/main.rs states "No credentials or authentication
# required" — and it reads the public StandX websocket feed only. There is no
# API key, no wallet, no account index to set here.
#
# The single variable it honours is log verbosity, read via tracing's
# EnvFilter and defaulting to "info" when unset.

# error | warn | info | debug | trace
# Accepts per-module directives too, e.g. info,standx_dry_run_grid::websocket=debug
RUST_LOG=info
